{
  "name": "@topaisaas/terracost-blast",
  "version": "1.0.1",
  "description": "Air-gapped Blast Radius & FinOps monthly delta cost calculator for Terraform JSON execution plans with zero network calls.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "terracost": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "action.yml",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild bin/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.js && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "start": "node dist/cli.js",
    "test": "node --test tests/terracost.test.js"
  },
  "keywords": [
    "terraform",
    "blast-radius",
    "finops",
    "cloud-cost",
    "infracost-alternative",
    "air-gapped",
    "devops",
    "iac",
    "aws",
    "gcp",
    "azure",
    "security"
  ],
  "author": "TopAI Sovereign Studio",
  "license": "Apache-2.0"
}
